<?xml version="1.0" encoding="utf-8"?>
<robot name="pendulum_double">

  <link name="world" />

  <joint name="base_weld" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 2.0" rpy="0 0 0" />
  </joint>
  
  <link name="base_link" />

  <joint name="pin" type="revolute">
    <parent link="base_link" />
    <child link="Link1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10" />
  </joint>

  <link name="Link1">
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.0833" ixy="0" ixz="0" iyy="0.0833" iyz="0" izz="0.00125" /> 
    </inertial>
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <cylinder length="1.0" radius="0.05" />
      </geometry>
      <material name="green"><color rgba="0 0.9 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <cylinder length="1.0" radius="0.05" />
      </geometry>
    </collision>
  </link>

  <joint name="pin2" type="revolute">
    <parent link="Link1" />
    <child link="Link2" />
    <origin xyz="0 0.1 1.0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="10" />
  </joint>

  <link name="Link2">
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.0833" ixy="0" ixz="0" iyy="0.0833" iyz="0" izz="0.00125" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <cylinder length="1.0" radius="0.05" />
      </geometry>
      <material name="blue"><color rgba="0 0 0.9 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0" />
      <geometry>
        <cylinder length="1.0" radius="0.05" />
      </geometry>
    </collision>
  </link>

</robot>
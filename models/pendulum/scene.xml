<?xml version="1.0" encoding="utf-8"?>
<mujoco model="pendulum_double_scene">
  
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.0001" integrator="RK4">
    <flag sensornoise="enable" energy="enable" contact="disable"/>
  </option>

  <visual>
    <global azimuth="90" elevation="-20" />
  </visual>

  <asset>
    <material name="groundplane" rgba=".9 0 0 1"/> 
  </asset>

  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    
    <geom name="floor" size="1 1 0.1" type="plane" material="groundplane" />
    
    <include file="pendulum_double.xml"/>
  </worldbody>

</mujoco>
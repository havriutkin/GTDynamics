<mujoco model="cartpole">
  <option gravity="0 0 -9.81" timestep="0.01" />

  <asset>
    <texture type="2d" name="ground" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.7 0.7 0.7" width="300" height="300"/>
    <material name="ground_mat" texture="ground" texrepeat="10 10"/>
    <material name="cart_mat" rgba="0.8 0.2 0.2 1"/>
    <material name="pole_mat" rgba="0.2 0.2 0.8 1"/>
  </asset>

  <visual>
    <global offwidth="800"/>
  </visual>
  <visual>
    <global offheight="600"/>
  </visual>

  <worldbody>
    <light name="top" pos="0 0 5" diffuse="1 1 1" specular=".8 .8 .8"/>
    <geom name="ground" type="plane" size="10 10 0.1" material="ground_mat" contype="1" conaffinity="1"/>
    <camera name="wide_view" pos="0 5 3" xyaxes="-1 0 0 0 -5 10" fovy="80"/>

    <body name="cart" pos="0 0 0.1">
      <joint name="cart_slider" type="slide" axis="1 0 0" limited="false" damping="0.1"/>
      
      <geom name="cart_geom" type="box" size="0.2 0.1 0.05" material="cart_mat"/>
      
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01" />

      <body name="pole" pos="0 0 0.05">
        <joint name="pole_hinge" type="hinge" axis="0 1 0" damping="0.01" />
        
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.5" size="0.04" material="pole_mat"/>
        
        <inertial pos="0 0 0.25" mass="0.1" diaginertia="0.001 0.001 0.001" />
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_motor" joint="cart_slider" gear="100" ctrlrange="-1.0 1.0" />
  </actuator>

  <sensor>
    <jointpos name="cart_pos" joint="cart_slider" />
    <jointpos name="pole_angle" joint="pole_hinge" />
    <jointvel name="cart_vel" joint="cart_slider" />
    <jointvel name="pole_vel" joint="pole_hinge" />
  </sensor>

  <keyframe>
    <key name="init" qpos="0 0.02" />
  </keyframe>
</mujoco>
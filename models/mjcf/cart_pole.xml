<mujoco model="cart_pole">
  <option integrator="RK4" />
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
  </visual>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.6 0.6 0.6"/>
    
    <geom name="rail" type="box" size="0.01 2 0.01" pos="0 0 -0.035" rgba="0.3 0.3 0.3 1"/>

    <body name="cart" pos="0 0 0">
      <joint name="j0" type="slide" axis="0 1 0" limited="false"/>
      
      <inertial mass="20" pos="0 0 0" diaginertia="0.0083333 0.0083333 0.0083333"/>
      
      <geom name="cart_geom" type="box" size="0.025 0.025 0.025" rgba="0.5 0.5 1.0 1"/>

      <body name="pole" pos="0 0 0">
        <joint name="j1" type="hinge" axis="1 0 0"/>
        
        <inertial mass="0.3" pos="0 0 0.15" diaginertia="0.00225 0.00225 0.000015"/>
        
        <geom name="pole_geom" type="cylinder" pos="0 0 0.15" size="0.01 0.15" rgba="1.0 0.5 0.5 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_actuator" joint="j0" ctrllimited="true" ctrlrange="-1000 1000"/>
  </actuator>

</mujoco>